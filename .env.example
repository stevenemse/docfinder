[TEMPLATE]
# ==============================================================================
# DocFinder Cameroun — Configuration Supabase
#
# 1. Créez un projet sur https://supabase.com (région la plus proche : Europe
#    ou États-Unis selon la latence mesurée depuis Douala/Yaoundé).
# 2. Exécutez supabase/schema.sql dans le SQL Editor du projet (il crée les
#    tables, politiques RLS, RPC de sécurité, buckets Storage et le seed).
# 3. Copiez ce fichier vers ".env.local" et collez vos clés :
#    Dashboard → Project Settings → API
#      - Project URL       → VITE_SUPABASE_URL
#      - anon / public key → VITE_SUPABASE_ANON_KEY
#    ⚠️ N'utilisez JAMAIS la clé service_role dans le frontend.
# 4. Relancez `npm run dev` : le pied de page passe de "Mode Démo" à
#    "Connecté à la base de données PostgreSQL Supabase".
#
# Pour la production (Vercel) : Project Settings → Environment Variables,
# mêmes deux variables, environnement Production + Preview.
#
# IMPORTANT : ce fichier est un modèle — .env.local est exclu de git (.gitignore)
# et ne doit jamais être commité.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
